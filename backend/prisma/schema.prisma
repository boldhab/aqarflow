generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  INACTIVE
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  NEGOTIATION
  CONVERTED
  LOST
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Agency {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  users          User[]
  properties     Property[]
  propertyImages PropertyImage[]
  leads          Lead[]
  leadNotes      LeadNote[]
  visits         Visit[]
  deals          Deal[]

  @@map("agencies")
}

model User {
  id               String       @id @default(uuid())
  agencyId         String
  agency           Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name             String
  email            String       @unique
  password         String
  role             UserRole     @default(AGENT)
  isActive         Boolean      @default(true)
  phone            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignedLeads    Lead[]       @relation("AssignedLeads")
  leadNotes        LeadNote[]
  visits           Visit[]      @relation("AgentVisits")
  deals            Deal[]       @relation("AgentDeals")
  createdProperties Property[]  @relation("CreatedProperties")

  @@index([agencyId])
  @@map("users")
}

model Property {
  id          String         @id @default(uuid())
  agencyId    String
  agency      Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?          @relation("CreatedProperties", fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  description String?
  price       Decimal        @db.Decimal(12, 2)
  currency    String         @default("USD")
  type        String         @default("APARTMENT")
  status      PropertyStatus @default(AVAILABLE)
  bedrooms    Int?
  bathrooms   Int?
  areaSqFt    Float?
  address     String?
  city        String?
  country     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  images      PropertyImage[]
  visits      Visit[]
  deals       Deal[]

  @@index([agencyId])
  @@index([agencyId, status])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([agencyId])
  @@index([propertyId])
  @@map("property_images")
}

model Lead {
  id           String     @id @default(uuid())
  agencyId     String
  agency       Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  name         String
  email        String?
  phone        String
  stage        LeadStage  @default(NEW)
  source       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  notes        LeadNote[]
  visits       Visit[]
  deals        Deal[]

  @@index([agencyId])
  @@index([agencyId, stage])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  createdAt DateTime @default(now())

  @@index([agencyId])
  @@index([leadId])
  @@map("lead_notes")
}

model Visit {
  id          String      @id @default(uuid())
  agencyId    String
  agency      Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       User?       @relation("AgentVisits", fields: [agentId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  status      VisitStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([agencyId])
  @@index([propertyId])
  @@index([leadId])
  @@map("visits")
}

model Deal {
  id         String     @id @default(uuid())
  agencyId   String
  agency     Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      User?      @relation("AgentDeals", fields: [agentId], references: [id], onDelete: SetNull)
  value      Decimal    @db.Decimal(12, 2)
  status     DealStatus @default(OPEN)
  closedAt   DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([agencyId])
  @@index([propertyId])
  @@index([leadId])
  @@map("deals")
}
