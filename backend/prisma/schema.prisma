generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  UNDER_OFFER
  SOLD
  RENTED
  LEASED
  INACTIVE
}

enum PropertyPurpose {
  SALE
  RENT
  LEASE
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  PLOT
  COMMERCIAL
  OFFICE
  SHOP
}

enum AreaUnit {
  SQFT
  SQM
  MARLA
  KANAL
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  NEGOTIATION
  CONVERTED
  LOST
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum PreferredContact {
  PHONE
  EMAIL
  WHATSAPP
}

enum LeadSource {
  WEBSITE
  MANUAL
}

model Agency {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logoUrl                 String?
  currency                String                  @default("PKR")
  timezone                String                  @default("Asia/Karachi")
  invoicePrefix           String                  @default("INV")
  taxNumber               String?
  commissionRate          Decimal                 @default(1.5) @db.Decimal(5, 2)
  contacts                Contact[]
  customers               Customer[]
  notifications           Notification[]
  emailJobs               EmailJob[]
  leases                  Lease[]
  invoices                Invoice[]
  payments                Payment[]
  expenses                Expense[]
  commissions             Commission[]
  maintenance             MaintenanceRequest[]
  branches                Branch[]
  auditLogs               AuditLog[]
  sequences               InvoiceSequence[]
  users                   User[]
  properties              Property[]
  propertyImages          PropertyImage[]
  propertyStatusHistories PropertyStatusHistory[]
  leads                   Lead[]
  leadNotes               LeadNote[]
  visits                  Visit[]
  deals                   Deal[]

  @@map("agencies")
}

model User {
  managedLeases Lease[]
  id            String   @id @default(uuid())
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name          String
  email         String   @unique
  password      String
  role          UserRole @default(AGENT)
  isActive      Boolean  @default(true)
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branchId              String?
  branch                Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  notifications         Notification[]
  commissions           Commission[]
  assignedLeads         Lead[]                  @relation("AssignedLeads")
  leadNotes             LeadNote[]
  visits                Visit[]                 @relation("AgentVisits")
  deals                 Deal[]                  @relation("AgentDeals")
  createdProperties     Property[]              @relation("CreatedProperties")
  assignedProperties    Property[]              @relation("AssignedProperties")
  propertyStatusChanges PropertyStatusHistory[] @relation("StatusChanges")

  @@index([agencyId])
  @@map("users")
}

model Property {
  id              String          @id @default(uuid())
  agencyId        String
  agency          Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  referenceCode   String
  title           String
  description     String?
  purpose         PropertyPurpose @default(SALE)
  type            PropertyType    @default(APARTMENT)
  status          PropertyStatus  @default(AVAILABLE)
  isPublished     Boolean         @default(false)
  price           Decimal         @db.Decimal(14, 2)
  currency        String          @default("PKR")
  areaValue       Decimal         @default(0) @db.Decimal(12, 2)
  areaUnit        AreaUnit        @default(SQFT)
  bedrooms        Int?
  bathrooms       Int?
  address         String?
  city            String?
  locality        String?
  latitude        Float?
  longitude       Float?
  assignedAgentId String?
  assignedAgent   User?           @relation("AssignedProperties", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?           @relation("CreatedProperties", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  branchId      String?
  branch        Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  favorites     SavedProperty[]
  leases        Lease[]
  maintenance   MaintenanceRequest[]
  images        PropertyImage[]
  statusHistory PropertyStatusHistory[]
  visits        Visit[]
  deals         Deal[]
  leads         Lead[]

  @@unique([agencyId, referenceCode])
  @@index([agencyId])
  @@index([status])
  @@index([city])
  @@index([purpose])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  storageKey String?
  caption    String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([agencyId])
  @@index([propertyId])
  @@map("property_images")
}

model PropertyStatusHistory {
  id          String         @id @default(uuid())
  propertyId  String
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agencyId    String
  agency      Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  fromStatus  PropertyStatus
  toStatus    PropertyStatus
  changedById String?
  changedBy   User?          @relation("StatusChanges", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([agencyId])
  @@index([propertyId])
  @@map("property_status_history")
}

model Lead {
  id               String           @id @default(uuid())
  agencyId         String
  agency           Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId       String?
  property         Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedAgentId  String?
  assignedAgent    User?            @relation("AssignedLeads", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  name             String
  phone            String
  email            String?
  message          String?
  preferredContact PreferredContact @default(PHONE)
  purpose          PropertyPurpose?
  source           LeadSource       @default(WEBSITE)
  stage            LeadStage        @default(NEW)
  normalizedPhone  String?
  normalizedEmail  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  contactId String?
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes     LeadNote[]
  visits    Visit[]
  deals     Deal[]

  @@index([agencyId])
  @@index([stage])
  @@index([propertyId])
  @@index([normalizedPhone])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  createdAt DateTime @default(now())

  @@index([agencyId])
  @@index([leadId])
  @@map("lead_notes")
}

model Visit {
  id              String      @id @default(uuid())
  agencyId        String
  agency          Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           User?       @relation("AgentVisits", fields: [agentId], references: [id], onDelete: SetNull)
  durationMinutes Int         @default(60)
  endsAt          DateTime
  meetingPoint    String?
  visitorCount    Int         @default(1)
  outcomeNotes    String?
  scheduledAt     DateTime
  status          VisitStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([agencyId])
  @@index([propertyId])
  @@index([leadId])
  @@map("visits")
}

model Deal {
  id              String       @id @default(uuid())
  agencyId        String
  agency          Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           User?        @relation("AgentDeals", fields: [agentId], references: [id], onDelete: SetNull)
  stage           DealStage    @default(INQUIRY)
  offerAmount     Decimal?     @db.Decimal(14, 2)
  agreedAmount    Decimal?     @db.Decimal(14, 2)
  expectedCloseAt DateTime?
  notes           String?
  commissions     Commission[]
  value           Decimal      @db.Decimal(12, 2)
  status          DealStatus   @default(OPEN)
  closedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([agencyId])
  @@index([propertyId])
  @@index([leadId])
  @@map("deals")
}

enum DealStage {
  INQUIRY
  QUALIFIED
  VISIT
  OFFER
  NEGOTIATION
  BOOKING
  DOCUMENTATION
  CLOSED_WON
  CLOSED_LOST
}

model Contact {
  id              String     @id @default(uuid())
  agencyId        String
  agency          Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  normalizedPhone String
  email           String?
  type            String     @default("BUYER")
  notes           String?
  customer        Customer?
  leads           Lead[]
  activities      Activity[]
  leases          Lease[]    @relation("TenantLeases")
  landlordLeases  Lease[]    @relation("LandlordLeases")
  invoices        Invoice[]
  payments        Payment[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([agencyId, normalizedPhone])
  @@map("contacts")
}

model Customer {
  id        String          @id @default(uuid())
  agencyId  String
  agency    Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contactId String          @unique
  contact   Contact         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  email     String
  password  String
  favorites SavedProperty[]
  createdAt DateTime        @default(now())

  @@unique([agencyId, email])
  @@map("customers")
}

model SavedProperty {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, propertyId])
  @@map("saved_properties")
}

model Activity {
  id          String   @id @default(uuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  actorId     String?
  type        String
  subject     String
  description String?
  occurredAt  DateTime @default(now())

  @@index([contactId, occurredAt])
  @@map("activities")
}

model Notification {
  id        String    @id @default(uuid())
  agencyId  String
  agency    Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

model EmailJob {
  id            String    @id @default(uuid())
  agencyId      String
  agency        Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  recipient     String
  subject       String
  body          String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@map("email_jobs")
}

model Lease {
  landlordContactId String?
  landlord          Contact?          @relation("LandlordLeases", fields: [landlordContactId], references: [id], onDelete: Restrict)
  managerUserId     String?
  manager           User?             @relation(fields: [managerUserId], references: [id], onDelete: SetNull)
  billingFrequency  String            @default("MONTHLY")
  dueDayOfMonth     Int?
  gracePeriodDays   Int               @default(5)
  notes             String?
  id                String            @id @default(uuid())
  agencyId          String
  agency            Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId        String
  property          Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  contactId         String
  contact           Contact           @relation("TenantLeases", fields: [contactId], references: [id], onDelete: Restrict)
  startDate         DateTime
  endDate           DateTime
  monthlyRent       Decimal           @db.Decimal(14, 2)
  depositAmount     Decimal           @default(0) @db.Decimal(14, 2)
  status            String            @default("ACTIVE")
  renewedFromId     String?           @unique
  renewedFrom       Lease?            @relation("LeaseRenewal", fields: [renewedFromId], references: [id])
  renewal           Lease?            @relation("LeaseRenewal")
  obligations       RentObligation[]
  deposits          DepositMovement[]
  createdAt         DateTime          @default(now())

  @@index([agencyId, status, endDate])
  @@map("leases")
}

model RentObligation {
  status       String    @default("PENDING")
  waiverReason String?
  periodStart  DateTime?
  periodEnd    DateTime?
  id           String    @id @default(uuid())
  leaseId      String
  lease        Lease     @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  dueDate      DateTime
  amount       Decimal   @db.Decimal(14, 2)
  amountPaid   Decimal   @default(0) @db.Decimal(14, 2)
  payments     Payment[]

  @@unique([leaseId, dueDate])
  @@map("rent_obligations")
}

model DepositMovement {
  id         String   @id @default(uuid())
  leaseId    String
  lease      Lease    @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  amount     Decimal  @db.Decimal(14, 2)
  type       String
  notes      String?
  requestKey String   @unique
  createdAt  DateTime @default(now())

  @@map("deposit_movements")
}

model InvoiceSequence {
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  year     Int
  value    Int    @default(0)

  @@id([agencyId, year])
  @@map("invoice_sequences")
}

model Invoice {
  id            String        @id @default(uuid())
  agencyId      String
  agency        Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  contactId     String
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  invoiceNumber String
  currency      String        @default("PKR")
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  subtotal      Decimal       @db.Decimal(14, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  status        String        @default("ISSUED")
  notes         String?
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([agencyId, invoiceNumber])
  @@index([agencyId, status, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  @@map("invoice_items")
}

model Payment {
  id            String          @id @default(uuid())
  agencyId      String
  agency        Agency          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  contactId     String
  contact       Contact         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  invoiceId     String?
  invoice       Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  obligationId  String?
  obligation    RentObligation? @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  amount        Decimal         @db.Decimal(14, 2)
  currency      String          @default("PKR")
  method        String          @default("BANK_TRANSFER")
  referenceCode String?
  requestKey    String
  paidAt        DateTime        @default(now())

  @@unique([agencyId, requestKey])
  @@index([agencyId, paidAt])
  @@map("payments")
}

model Expense {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  category    String
  description String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("PKR")
  receiptUrl  String?
  date        DateTime @default(now())

  @@index([agencyId, date])
  @@map("expenses")
}

model Commission {
  id         String    @id @default(uuid())
  agencyId   String
  agency     Agency    @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  dealId     String    @unique
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Restrict)
  agentId    String
  agent      User      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  rate       Decimal   @db.Decimal(5, 2)
  amount     Decimal   @db.Decimal(14, 2)
  status     String    @default("PENDING_APPROVAL")
  approvedAt DateTime?
  paidAt     DateTime?

  @@index([agencyId, status])
  @@map("commissions")
}

model MaintenanceRequest {
  id          String    @id @default(uuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  title       String
  description String
  category    String
  priority    String    @default("MEDIUM")
  status      String    @default("OPEN")
  assignedTo  String?
  cost        Decimal?  @db.Decimal(14, 2)
  photos      String[]  @default([])
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([agencyId, status])
  @@map("maintenance_requests")
}

model Branch {
  id         String     @id @default(uuid())
  agencyId   String
  agency     Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name       String
  address    String
  city       String
  phone      String?
  users      User[]
  properties Property[]

  @@unique([agencyId, name])
  @@map("branches")
}

model AuditLog {
  id         String   @id @default(uuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
  @@map("audit_logs")
}
