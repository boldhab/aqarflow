generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  UNDER_OFFER
  SOLD
  RENTED
  LEASED
  INACTIVE
}

enum PropertyPurpose {
  SALE
  RENT
  LEASE
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  PLOT
  COMMERCIAL
  OFFICE
  SHOP
}

enum AreaUnit {
  SQFT
  SQM
  MARLA
  KANAL
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  NEGOTIATION
  CONVERTED
  LOST
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum PreferredContact {
  PHONE
  EMAIL
  WHATSAPP
}

enum LeadSource {
  WEBSITE
  MANUAL
}


model Agency {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  users                   User[]
  properties              Property[]
  propertyImages          PropertyImage[]
  propertyStatusHistories PropertyStatusHistory[]
  leads                   Lead[]
  leadNotes               LeadNote[]
  visits                  Visit[]
  deals                   Deal[]

  @@map("agencies")
}

model User {
  id               String       @id @default(uuid())
  agencyId         String
  agency           Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name             String
  email            String       @unique
  password         String
  role             UserRole     @default(AGENT)
  isActive         Boolean      @default(true)
  phone            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignedLeads         Lead[]                  @relation("AssignedLeads")
  leadNotes             LeadNote[]
  visits                Visit[]                 @relation("AgentVisits")
  deals                 Deal[]                  @relation("AgentDeals")
  createdProperties     Property[]              @relation("CreatedProperties")
  assignedProperties    Property[]              @relation("AssignedProperties")
  propertyStatusChanges PropertyStatusHistory[] @relation("StatusChanges")

  @@index([agencyId])
  @@map("users")
}

model Property {
  id              String          @id @default(uuid())
  agencyId        String
  agency          Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  referenceCode   String
  title           String
  description     String?
  purpose         PropertyPurpose @default(SALE)
  type            PropertyType    @default(APARTMENT)
  status          PropertyStatus  @default(AVAILABLE)
  isPublished     Boolean         @default(false)
  price           Decimal         @db.Decimal(14, 2)
  currency        String          @default("PKR")
  areaValue       Decimal         @default(0) @db.Decimal(12, 2)
  areaUnit        AreaUnit        @default(SQFT)
  bedrooms        Int?
  bathrooms       Int?
  address         String?
  city            String?
  locality        String?
  latitude        Float?
  longitude       Float?
  assignedAgentId String?
  assignedAgent   User?           @relation("AssignedProperties", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?           @relation("CreatedProperties", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  images        PropertyImage[]
  statusHistory PropertyStatusHistory[]
  visits        Visit[]
  deals         Deal[]
  leads         Lead[]

  @@unique([agencyId, referenceCode])
  @@index([agencyId])
  @@index([status])
  @@index([city])
  @@index([purpose])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  storageKey String?
  caption    String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([agencyId])
  @@index([propertyId])
  @@map("property_images")
}

model PropertyStatusHistory {
  id          String         @id @default(uuid())
  propertyId  String
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agencyId    String
  agency      Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  fromStatus  PropertyStatus
  toStatus    PropertyStatus
  changedById String?
  changedBy   User?          @relation("StatusChanges", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([agencyId])
  @@index([propertyId])
  @@map("property_status_history")
}

model Lead {
  id               String           @id @default(uuid())
  agencyId         String
  agency           Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId       String?
  property         Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedAgentId  String?
  assignedAgent    User?            @relation("AssignedLeads", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  name             String
  phone            String
  email            String?
  message          String?
  preferredContact PreferredContact @default(PHONE)
  purpose          PropertyPurpose?
  source           LeadSource       @default(WEBSITE)
  stage            LeadStage        @default(NEW)
  normalizedPhone  String?
  normalizedEmail  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  notes        LeadNote[]
  visits       Visit[]
  deals        Deal[]

  @@index([agencyId])
  @@index([stage])
  @@index([propertyId])
  @@index([normalizedPhone])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  createdAt DateTime @default(now())

  @@index([agencyId])
  @@index([leadId])
  @@map("lead_notes")
}

model Visit {
  id          String      @id @default(uuid())
  agencyId    String
  agency      Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       User?       @relation("AgentVisits", fields: [agentId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  status      VisitStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([agencyId])
  @@index([propertyId])
  @@index([leadId])
  @@map("visits")
}

model Deal {
  id         String     @id @default(uuid())
  agencyId   String
  agency     Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      User?      @relation("AgentDeals", fields: [agentId], references: [id], onDelete: SetNull)
  value      Decimal    @db.Decimal(12, 2)
  status     DealStatus @default(OPEN)
  closedAt   DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([agencyId])
  @@index([propertyId])
  @@index([leadId])
  @@map("deals")
}
