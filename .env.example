# Backend (Render)
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/aqarflow?sslmode=require
JWT_SECRET=super_secret_jwt_random_key_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SAMESITE=none
FRONTEND_URL=https://your-frontend.vercel.app
DEFAULT_AGENCY_SLUG=demo-agency

# Frontend (Vercel)
BACKEND_API_URL=https://your-backend.onrender.com/api/v1
BACKEND_URL=https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=/api/v1

# Optional S3-compatible cloud storage (AWS S3 / Cloudflare R2)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Durable email delivery: schedule npm run email:deliver --workspace=backend every minute
RESEND_API_KEY=
EMAIL_FROM=
